# Copy to `.env` and fill real values. `.env` is gitignored — never commit secrets.
# Jenkins ignores this file too; it injects MYSQL_ROOT_PASSWORD from the
# `mysql-root-password` credential and SONAR_TOKEN from `sonar-token`
# (shell env overrides compose defaults).

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=test_db
SPRING_DATASOURCE_USERNAME=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update

DOCKERHUB_NAMESPACE=twelvy1400

# JUNIOR: SonarQube settings (see SONARQ.md). Token is NEVER stored here —
# Jenkins credential `sonar-token` injects SONAR_TOKEN at analysis time.
SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY=devops-appgestiondesprojets
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=change-me-sonar
SONAR_JDBC_DATABASE=sonar

# Grafana admin (monitoring profile; dashboards are also readable anonymously)
GRAFANA_ADMIN_PASSWORD=change-me-grafana
