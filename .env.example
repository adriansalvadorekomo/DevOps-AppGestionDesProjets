# Copy to `.env` and fill real values. `.env` is gitignored — never commit secrets.
# Jenkins ignores this file too; it injects MYSQL_ROOT_PASSWORD from the
# `mysql-root-password` credential (shell env overrides compose defaults).

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=test_db
SPRING_DATASOURCE_USERNAME=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update

DOCKERHUB_NAMESPACE=twelvy1400
